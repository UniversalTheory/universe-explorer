{
  "name": "universe-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time, high-fidelity 3D map of the Solar System and the Milky Way in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:build": "tsx scripts/build-data.ts",
    "data:textures": "bash scripts/fetch-textures.sh",
    "test": "tsx scripts/verify-ephemeris.ts",
    "data:deepsky-images": "tsx scripts/fetch-deepsky-images.ts && python3 scripts/compress-deepsky.py",
    "check": "for s in stars exoplanets deepsky compact galaxy; do npx tsx scripts/dev/$s-check.ts || exit 1; done"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "satellite.js": "^5.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
